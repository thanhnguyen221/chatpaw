# ============================================
# PawTalk - Environment Variables Example
# ============================================
# Copy file này thành .env và điền các giá trị thật
# File .env đã được thêm vào .gitignore để tránh bị push lên GitHub

# Flask Configuration
SECRET_KEY=your_secret_key_here

# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017/your_database_name

# Cloudinary Configuration
# Lấy từ: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_ENABLED=True

# Google Gemini AI Configuration
# Lấy từ: https://ai.google.dev/
GENAI_API_KEY=your_genai_api_key

# Message Encryption Configuration
# Để trống MESSAGE_ENCRYPTION_KEY để tự động generate từ SECRET + SALT
MESSAGE_ENCRYPTION_KEY=
MESSAGE_ENCRYPTION_SECRET=your_encryption_secret_here
MESSAGE_ENCRYPTION_SALT=your_encryption_salt_here
